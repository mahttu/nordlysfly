# Kopier denne filen til .env og fyll inn. .env skal ALDRI lastes opp til GitHub.

# Hvilken prisleverandør: mock (testdata) eller travelpayouts
PROVIDER=travelpayouts

# API-nøkkel fra Travelpayouts: finnes i profilen din (API token)
TRAVELPAYOUTS_TOKEN=lim_inn_nøkkelen_her

# Valgfritt: din partner-ID (marker), gir provisjon når noen bestiller via lenkene
TRAVELPAYOUTS_MARKER=
